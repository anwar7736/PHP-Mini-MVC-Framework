<?php
    $className = $argv[2];
    $fileName = 'app/Models/' . $className . '.php';
    if (file_exists($fileName)) 
    {
        echo "$className Model already exists\n";
        exit;
    }

    $content = "<?php\n";
    $content .= "namespace App\Models;\n";
    $content .= "use App\Models\Model;\n\n";
    $content .= "class $className extends Model\n{\n\n";
    $content .= "}\n";

    file_put_contents($fileName, $content);
    echo "$className Model created successfully\n";
?>
