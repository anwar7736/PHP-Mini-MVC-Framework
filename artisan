<?php 
    require './config/Schema.php';
    require './config/Blueprint.php';
    require './config/errors.php';
    
    function getSeedFromArgs() {
        global $argv;
        foreach ($argv as $arg) {
            if (strpos($arg, '--seed') === 0) {
                return true;
            }
        }
        return false;
    }

    function getClassFromArgs() {
        global $argv;
        foreach ($argv as $arg) {
            if (strpos($arg, '--class=') === 0) {
                return substr($arg, strlen('--class='));
            }
        }
        return null;
    }

    function getStepFromArgs() {
        global $argv;
        foreach ($argv as $arg) {
            if (strpos($arg, '--step=') === 0) {
                return substr($arg, strlen('--step='));
            }
        }
        return null;
    }

    function runSeeders()
    {
        $seedersDir = __DIR__ . '/database/seeders';

        foreach (glob($seedersDir . '/*.php') as $file) {
            require_once $file;
        }

        $class = getClassFromArgs();

        if ($class) {
            // Run a single seeder
            $full = "Database\\Seeders\\{$class}";
            echo "Running single seeder: {$full}\n";

            if (!class_exists($full)) {
                echo "Seeder {$full} not found\n";
                return;
            }

            $instance = new $full();
            $instance->run();
            echo "Seeder executed successfully.\n";
            return;
        }

        // Run DatabaseSeeder
        $dbSeeder = "Database\\Seeders\\DatabaseSeeder";

        if (!class_exists($dbSeeder)) {
            echo "DatabaseSeeder not found\n";
            return;
        }

        echo "Running DatabaseSeeder...\n";
        $instance = new $dbSeeder();
        $instance->run();
    }

    function migrateUpDown($method = 'up') {
        $migrationsDir = __DIR__ . '/database/migrations';
        $step = getStepFromArgs();
        $seed = getSeedFromArgs();
        if (!file_exists($migrationsDir)) {
            mkdir($migrationsDir, 0755, true);
        }


        $migrationFiles = glob($migrationsDir . '/*.php');
        $currentStep = 0;
        foreach ($migrationFiles as $migrationFile) {

            if ($step !== null && $currentStep >= $step) {
                break;
            }

            require_once $migrationFile;

            $baseClass = pathinfo($migrationFile, PATHINFO_FILENAME);     // CreateStudentsTable
            $className = "Database\\Migrations\\$baseClass";              // Database\Migrations\CreateStudentsTable

            if (!class_exists($className)) {
                echo "Class $className not found in $migrationFile\n";
                continue;
            }

            $instance = new $className();
            echo "Running migration: $className\n";
            
            if (method_exists($instance, $method)) {
                $instance->$method();
                $currentStep++;
                echo ($method === 'up' ? "Applied" : "Rolled back") . " migration: $className\n";
            }

        }

        if($method == 'up' && $seed){
            runSeeders();
        }
    }

    
